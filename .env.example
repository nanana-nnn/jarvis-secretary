HOST=192.168.0.x
PORT=8787
TLS_CERT=./certs/lan.crt
TLS_KEY=./certs/lan.key
ALLOWED_ORIGINS=https://192.168.0.x:5173

# --- Vault ---
VAULT_PATH=/home/you/Documents/Start Vault

# --- 音声認識 ---
# 実測で small を採用（12秒の日本語で 0.22x / 785MB）。medium は 0.65x / 1957MB。
# 肉声で精度が足りなければ medium へ上げる
WHISPER_MODEL=small

# --- エージェント ---
# `codex exec --help` で確認した確定形（2026-08-31）。ハードコードしない（DESIGN §10）。
# {sandbox} {cwd} {prompt_file} {schema_file} {out_file} が置換される。
# 発話はここに展開せず、prompt_file 経由で標準入力から渡す
CODEX_CMD=codex exec --sandbox {sandbox} --cd {cwd} --output-schema {schema_file} --output-last-message {out_file} --skip-git-repo-check
