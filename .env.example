HOST=192.168.0.x
PORT=8787
TLS_CERT=./certs/lan.crt
TLS_KEY=./certs/lan.key
ALLOWED_ORIGINS=https://192.168.0.x:5173

# --- Vault ---
VAULT_PATH=/home/you/Documents/Start Vault

# --- 音声認識 ---
# 実測で small を採用（12秒の日本語で 0.22x / 785MB）。medium は 0.65x / 1957MB。
# 肉声で精度が足りなければ medium へ上げる
WHISPER_MODEL=small

# --- エージェント ---
# `codex exec --help` で確認した確定形（2026-08-31）。ハードコードしない（DESIGN §10）。
# {sandbox} {cwd} {prompt_file} {schema_file} {out_file} が置換される。
# 発話はここに展開せず、prompt_file 経由で標準入力から渡す
# 実行役エージェント。バックエンドはこのテンプレートだけで決まる（§2「アダプター層は差し替え可能に保つ」）。
# 契約: プロンプトは stdin / 答えの JSON を {out_file} へ書く / 終了コード 0 が成功。
#
# 既定：Codex CLI
AGENT_CMD=codex exec --sandbox {sandbox} --cd {cwd} --output-schema {schema_file} --output-last-message {out_file} --skip-git-repo-check
AGENT_SANDBOX_READ=read-only
AGENT_SANDBOX_WRITE=workspace-write
#
# 代替：Claude Code（Codex の利用枠が切れたときはこの3行に差し替える）
# --output-format text は最終メッセージだけを出すので、そのまま {out_file} へ流せる。
# --output-schema が無いぶん、返す JSON の形はプロンプト側で指定している。
# 実測（2026-09-01）読み取り20秒 / 書き込み16秒。Codex の実測42.6秒より速い。
# AGENT_CMD=cd {cwd} && claude -p --output-format text {sandbox} > {out_file}
# AGENT_SANDBOX_READ=--allowedTools "Read,Glob,Grep"
# AGENT_SANDBOX_WRITE=--permission-mode acceptEdits
